{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Memory",
  "description": "memory.yaml: facts the runs should know.",
  "type": "array",
  "items": {
    "type": "object",
    "required": ["text"],
    "properties": {
      "text": { "type": "string", "minLength": 1, "description": "One fact." },
      "added": { "type": "string", "pattern": "^[0-9]{4}$" }
    }
  }
}
