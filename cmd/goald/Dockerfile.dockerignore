# The image builds from the repository root and needs the Go module, goald's packages, the
# migrations, the schemas and the web UI's workspace.
*
!go.mod
!go.sum
!cmd/goald/
!internal/
!db/migrations/
!contracts/definitions/
!apps/web/
!packages/api-client/
!package.json
!pnpm-lock.yaml
!pnpm-workspace.yaml
**/node_modules/
apps/web/dist/
apps/web/e2e/
apps/web/e2e-auth/
**/*_test.go
