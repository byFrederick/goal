# Copy to .env (git-ignored) and fill in. goald reads these at start and resolves the env:NAME
# references in each factory.yaml on the host; values never reach agent containers or logs.
# Taskfile.yml loads this file for every task.
# 1Password replaces this file in the last phase; AWS deployments use Secrets Manager instead.

# Model auth for agent containers (from `claude setup-token`; personal laptop use only)
CLAUDE_CODE_OAUTH_TOKEN=

# Local PostgreSQL (compose.yaml). GOAL_PG_PASSWORD is the bootstrap superuser's, used only by
# `goal db init` (goal up runs it) to create the two roles goald uses: goal_owner runs migrations,
# goal_app runs everything else under row-level security.
GOAL_PG_PASSWORD=goal-dev-only
GOAL_PG_OWNER_PASSWORD=goal-owner-dev-only
GOAL_PG_APP_PASSWORD=goal-app-dev-only
# GOAL_DATABASE_ADMIN_URL=postgres://goal:goal-dev-only@127.0.0.1:5432/goal?sslmode=disable   # goal db init; default: compose's superuser

# Object storage: factory definitions and knowledge live in one versioned bucket under orgs/<org-id>/factories/<id>/.
# Locally RustFS (compose.yaml) stands in for S3; the access and secret keys are its dev-only root user.
# On AWS: set GOAL_S3_BUCKET to the platform bucket (goal-<account>-<region>), leave the endpoint and
# keys empty, and the standard AWS credential chain (AWS_PROFILE, SSO, ECS task role) applies.
GOAL_S3_BUCKET=goal-local
GOAL_S3_ENDPOINT=http://127.0.0.1:9000
GOAL_S3_ACCESS_KEY=goal-dev-only
GOAL_S3_SECRET_KEY=goal-dev-only-secret
AWS_REGION=us-east-1

# goald (cmd/goald/settings.go has every variable and its default)
# Signs the per-task MCP gateway tokens; generate with `openssl rand -hex 32`. Never reaches a task.
GOAL_GATEWAY_KEY=
# GOAL_MIGRATE_DATABASE_URL=postgres://goal_owner:goal-owner-dev-only@127.0.0.1:5432/goal?sslmode=disable  # migrations; default: compose's database as goal_owner
# GOAL_DATABASE_URL=postgres://goal_app:goal-app-dev-only@127.0.0.1:5432/goal?sslmode=disable  # default: compose's database as goal_app; never a superuser or owner
# GOAL_LISTEN=127.0.0.1:8080             # API and gateway; loopback only (the phase 1 API has no auth)
# GOAL_API_URL=http://127.0.0.1:8080     # where the goal CLI finds goald
# GOAL_GATEWAY_URL=http://127.0.0.1:8080/mcp  # as agent containers see it (loopback becomes host.docker.internal)
# GOAL_WORKSPACE_ROOT=                   # per-run git checkouts; default $TMPDIR/goal-workspaces
# GOAL_RUN_DIR=                          # per-run agent files; default $TMPDIR/goal-runs
# GOAL_TASK_ENV=CLAUDE_CODE_OAUTH_TOKEN=env:CLAUDE_CODE_OAUTH_TOKEN  # secrets every agent task gets, as references
# GOAL_TICK_EVERY=5s  GOAL_REFRESH_EVERY=30s  GOAL_LOG_LEVEL=info  GOAL_LOG_FORMAT=json
# GOAL_MAX_RUNS=0                        # agent runs one goald runs at once, shared fairly across organizations; 0 = no cap
# GOAL_GITHUB_API_URL=https://api.github.com  # where goald merges pull requests (goal merge)

# Local working copy of the factory definitions (outside this repository, not under git)
GOAL_FACTORIES_DIR=../goal-factories

# goal factory
GOAL_GITHUB_TOKEN=            # fine-grained PAT, this repository only: clones on the host, GitHub MCP in the gateway, goal merge (contents + pull requests: write)
GOAL_DEV_DATABASE_URL=        # read-only role on the dev database

# sre factory
GOAL_SRE_GITHUB_TOKEN=        # read-only
GOAL_SRE_GRAFANA_TOKEN=       # Grafana service account, viewer

# university factory
GOAL_UNIVERSITY_ZOTERO_API_KEY=
