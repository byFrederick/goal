# Copy to .env (git-ignored) and fill in. goald reads these at start and resolves the env:NAME
# references in each factory.yaml on the host; values never reach agent containers or logs.
# Taskfile.yml loads this file for every task.
# 1Password replaces this file in the last phase; AWS deployments use Secrets Manager instead.

# Model auth for agent containers (from `claude setup-token`; personal laptop use only)
CLAUDE_CODE_OAUTH_TOKEN=

# Local PostgreSQL (compose.yaml). GOAL_PG_PASSWORD is the bootstrap superuser's, used only by
# `goal db init` (goal up runs it) to create the roles: goal_owner runs migrations, goal_app runs
# goald under row-level security, goal_auth runs the identity service (auth/, Better Auth's tables only).
GOAL_PG_PASSWORD=goal-dev-only
GOAL_PG_OWNER_PASSWORD=goal-owner-dev-only
GOAL_PG_APP_PASSWORD=goal-app-dev-only
GOAL_PG_AUTH_PASSWORD=goal-auth-dev-only
# GOAL_DATABASE_ADMIN_URL=postgres://goal:goal-dev-only@127.0.0.1:5432/goal?sslmode=disable   # goal db init; default: compose's superuser

# Object storage: factory definition files (blobs under orgs/<org-id>/blobs/, versions in PostgreSQL) and the
# catalogs live in one versioned bucket. goald reads and writes it; the CLI only for goal storage init and goal catalog.
# Locally RustFS (compose.yaml) stands in for S3; the access and secret keys are its dev-only root user.
# On AWS: set GOAL_S3_BUCKET to the platform bucket (goal-<account>-<region>), leave the endpoint and
# keys empty, and the standard AWS credential chain (AWS_PROFILE, SSO, ECS task role) applies.
GOAL_S3_BUCKET=goal-local
GOAL_S3_ENDPOINT=http://127.0.0.1:9000
GOAL_S3_ACCESS_KEY=goal-dev-only
GOAL_S3_SECRET_KEY=goal-dev-only-secret
AWS_REGION=us-east-1

# goald (cmd/goald/settings.go has every variable and its default)
# Signs the per-task MCP gateway tokens; generate with `openssl rand -hex 32`. Never reaches a task.
GOAL_GATEWAY_KEY=
# GOAL_MIGRATE_DATABASE_URL=postgres://goal_owner:goal-owner-dev-only@127.0.0.1:5432/goal?sslmode=disable  # migrations; default: compose's database as goal_owner
# GOAL_DATABASE_URL=postgres://goal_app:goal-app-dev-only@127.0.0.1:5432/goal?sslmode=disable  # default: compose's database as goal_app; never a superuser or owner
# GOAL_LISTEN=127.0.0.1:8080             # API, UI, and gateway without GOAL_GATEWAY_LISTEN; off loopback only with
#                                        # GOAL_AUTH=session, an https GOAL_PUBLIC_URL and GOAL_GATEWAY_LISTEN
# GOAL_GATEWAY_LISTEN=                   # the gateway's own listener, serving only /mcp (the main one then 404s /mcp);
#                                        # on Linux set the Docker bridge's address (172.17.0.1:8090) so containers reach
#                                        # the gateway and not the API; Docker Desktop and OrbStack need nothing
# GOAL_PUBLIC_URL=http://127.0.0.1:8080  # the one origin people open goald at (https unless loopback; default
#                                        # http://<GOAL_LISTEN>); sign-in links and cookies follow it, and requests naming
#                                        # any other host than it, GOAL_LISTEN's and localhost/127.0.0.1/[::1] get 421
# GOAL_API_URL=http://127.0.0.1:8080     # where the goal CLI finds goald
# GOAL_GATEWAY_URL=http://127.0.0.1:8080/mcp  # where the egress proxy forwards agents' /mcp; default follows GOAL_GATEWAY_LISTEN (loopback becomes host.docker.internal)
# Agents, networked sidecars and checks reach the outside only through goald's egress proxy (ADR 0009; task egress:image builds it):
# GOAL_AGENT_EGRESS=api.anthropic.com     # hosts agents may reach besides the gateway (host or host:port, 443 by default), comma-separated;
#                                         # add package registries (proxy.golang.org, registry.npmjs.org) if agents install packages themselves
# GOAL_EGRESS_NAME=goal-egress            # the proxy's container and network names; one per goald configuration on a Docker host
# GOAL_EGRESS_IMAGE=ghcr.io/byfrederick/goal-egress:0.1.0
# GOAL_WORKSPACE_ROOT=                   # per-run git checkouts; default $TMPDIR/goal-workspaces
# GOAL_RUN_DIR=                          # per-run agent files; default $TMPDIR/goal-runs
# GOAL_TASK_ENV=CLAUDE_CODE_OAUTH_TOKEN=env:CLAUDE_CODE_OAUTH_TOKEN  # secrets every agent task gets, as references
# GOAL_TICK_EVERY=5s  GOAL_REFRESH_EVERY=30s  GOAL_LOG_LEVEL=info  GOAL_LOG_FORMAT=json
# GOAL_DEFINITION_CACHE_BYTES=67108864  GOAL_LEGACY_IMPORT=true  # the import runs once per organization from before versions
# GOAL_MAX_RUNS=0                        # agent runs one goald runs at once, shared fairly across organizations; 0 = no cap
# GOAL_GITHUB_API_URL=https://api.github.com  # where goald merges pull requests (goal merge) and goal catalog skills sync reads skills
# GOAL_GITHUB_WEB_URL=https://github.com      # the only host GOAL_GITHUB_TOKEN goes to: repositories are cloned and merged there only (GitHub Enterprise: its origin)
# GOAL_MODELS=claude-opus-5-5,claude-sonnet-5-5,claude-haiku-5-5  # models the factory editor offers, the first is the default (id or id=Label)

# Sign-in (spec 3). Under GOAL_AUTH=session goal up starts the identity service
# (node auth/dist/server.js, `task auth:build`) and Mailpit beside goald, and gives each process only
# its own variables: goald never sees the auth service's secrets below.
# GOAL_AUTH=session                      # the default; none: no sign-in, every request is the single local user (loopback only,
#                                        # one developer's laptop; turn it back on any time without losing data)
# The auth service's secret: session signing and token encryption; `openssl rand -hex 32`, never GOAL_GATEWAY_KEY.
BETTER_AUTH_SECRET=
# BETTER_AUTH_SECRETS=2:<new>,1:<old>    # instead, to rotate: versioned secrets, newest first
# The first owner's address: while nobody has signed in it is the only one that may, and becomes platform
# admin and owner of every organization. A mistake is fixed here and with a restart, until that first sign-in.
GOAL_BOOTSTRAP_OWNER_EMAIL=        # such as owner@example.com
# GOAL_SMTP_URL=smtp://127.0.0.1:1025    # where codes and invitations are mailed (smtps:// with user:password for a
#                                        # real server); default compose's Mailpit, read at http://127.0.0.1:8025
# GOAL_SMTP_FROM=Goal <goal@localhost>   # the sender
# GOAL_AUTH_GOOGLE=off                   # on: also sign in with Google (an OAuth client of type Web application whose
#                                        # redirect URI is <GOAL_PUBLIC_URL>/api/auth/callback/google)
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GOAL_AUTH_LISTEN=127.0.0.1:8081        # the identity service's address, loopback only (goald's /api/auth proxy is the way in)
# GOAL_AUTH_UPSTREAM=http://127.0.0.1:8081  # where goald's proxy reaches it (http on loopback)
# GOAL_AUTH_DATABASE_URL=postgres://goal_auth:goal-auth-dev-only@127.0.0.1:5432/goal?sslmode=disable  # default from GOAL_PG_AUTH_PASSWORD
# BETTER_AUTH_URL=                       # leave unset: it must equal GOAL_PUBLIC_URL
# GOAL_TRUSTED_PROXIES=                  # CIDRs of proxies in front of goald whose X-Forwarded-For names the client
# The CLI: goal login keeps its session in the OS keychain; for scripts and CI an API key (goal_sk_…) or a
# personal token (goal_pat_…) from the UI instead, which acts in its own organization.
# GOAL_API_KEY=
# GOAL_ORG=                              # the organization CLI commands act in (else goal org use's)

# goal catalog skills sync (operator): skills from skills.sh, read from GitHub (GOAL_GITHUB_TOKEN, when set, raises the rate limit)
# GOAL_SKILLS_DIRECTORY_URL=https://skills.sh
GOAL_SKILLS_DIRECTORY_TOKEN=  # bearer token of the skills.sh API; only --search needs it

# Local working copy of the factory definitions (outside this repository, not under git)
GOAL_FACTORIES_DIR=../goal-factories

# goal factory
GOAL_GITHUB_TOKEN=            # fine-grained PAT, this repository only: clones on the host, GitHub MCP in the gateway, goal merge (contents + pull requests: write)
GOAL_DEV_DATABASE_URL=        # read-only role on the dev database

# sre factory
GOAL_SRE_GITHUB_TOKEN=        # read-only
GOAL_SRE_GRAFANA_TOKEN=       # Grafana service account, viewer

# university factory
GOAL_UNIVERSITY_ZOTERO_API_KEY=
