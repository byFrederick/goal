# The image builds from the repository root. The runtime needs only the workspace manifests and
# worker/; the dev variant also reads go.mod, go.sum and terraform/ to prewarm its caches.
*
!package.json
!pnpm-lock.yaml
!pnpm-workspace.yaml
!worker/
worker/node_modules/
worker/dist/
!go.mod
!go.sum
!terraform/
terraform/.terraform/
terraform/backend.hcl
terraform/terraform.tfvars
terraform/*.tfstate*
