{
  "extends": "@goal/config/tsconfig.browser.json",
  "compilerOptions": {
    "jsx": "react-jsx",
    "types": ["vite/client", "node"],
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "allowImportingTsExtensions": true
  },
  // The service worker is checked against the WebWorker lib in src/sw/tsconfig.json (typecheck).
  "include": [
    "src",
    "scripts",
    "mock",
    "e2e",
    "e2e-auth",
    "vite.config.ts",
    "playwright.config.ts",
    "playwright.auth.config.ts"
  ],
  "exclude": ["src/sw/sw.ts"]
}
