// sandboxtest's Worker (worker.ts): the sandbox API with boxes from a small image of sandboxtest's
// commands. task cloudflare:sandboxtest runs it with wrangler dev and GOAL_SANDBOX_KEY as a --var.
{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "goal-sandboxtest",
  "main": "worker.ts",
  "compatibility_date": "2026-10-01",
  "containers": [
    {
      "class_name": "RunBox",
      "scheduling_policy": "durable_object",
      "images": { "sandboxtest": { "dockerfile": "./box.Dockerfile" } }
    }
  ],
  "durable_objects": {
    "bindings": [{ "name": "BOXES", "class_name": "RunBox" }, { "name": "BOX_INDEX", "class_name": "BoxIndex" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["RunBox", "BoxIndex"] }]
}
