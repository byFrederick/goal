{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "extends": ["@goal/config/biome.json"],
  "files": { "includes": ["src/**", "*.json", "*.ts", "!**/*.gen.*"] },
  "overrides": [
    {
      "includes": ["src/mail/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": ["../*"],
                    "message": "src/mail is the Mailer port and its adapters: it imports nothing else of the service (spec 3 §5.4)"
                  }
                ]
              }
            }
          }
        }
      }
    }
  ]
}
