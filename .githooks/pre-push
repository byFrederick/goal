#!/bin/sh
# Local gate for every push (install once: `task hooks:install`). CI (.github/workflows/ci.yml)
# runs the same gate on every pull request and push to main; this hook catches it before the push:
#   - always: task check (lint, race tests, factory validation, task tf:check)
#   - when the pushed commits touch db/migrations/ or apps/auth/: task migrate-check as well (with the
#     Better Auth schema drift check, task auth:schema-check)
# It checks the working tree you push from; commit or stash unrelated edits first.
# Bypass only in an emergency with `git push --no-verify`, and say so in the pull request.
set -eu

zero=0000000000000000000000000000000000000000
migrations=""

# git passes one line per ref: <local ref> <local sha> <remote ref> <remote sha>
while read -r _local_ref local_sha _remote_ref remote_sha; do
	case "$local_sha" in "$zero" | 00000000*) continue ;; esac # deleting a remote branch
	case "$remote_sha" in
	"$zero" | 00000000*) range="$local_sha --not --remotes" ;; # new branch: commits no remote has
	*) range="$remote_sha..$local_sha" ;;
	esac
	# shellcheck disable=SC2086 # range is intentionally split into git arguments
	if [ -n "$(git log --format= --name-only $range -- db/migrations/ apps/auth/)" ]; then
		migrations=yes
	fi
done

if ! command -v task >/dev/null 2>&1; then
	echo "pre-push: task is not installed (https://taskfile.dev; mise install)" >&2
	exit 1
fi

echo "pre-push: task check" >&2
task check

if [ -n "$migrations" ]; then
	echo "pre-push: db/migrations/ or apps/auth/ changed, task migrate-check" >&2
	task migrate-check
fi
