{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Diagnosis",
  "type": "object",
  "required": ["hypothesis", "confidence", "evidence", "recommendation"],
  "properties": {
    "hypothesis": { "type": "string" },
    "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
    "evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["source", "link", "finding"],
        "properties": {
          "source": { "enum": ["aws", "grafana", "github", "knowledge", "other"] },
          "link": { "type": "string" },
          "finding": { "type": "string" }
        }
      }
    },
    "recommendation": { "type": "string" },
    "risk": { "enum": ["low", "medium", "high"] },
    "runbook": { "type": "string", "description": "Knowledge base key of a runbook used or created" }
  }
}
