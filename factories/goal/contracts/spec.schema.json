{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Spec",
  "type": "object",
  "required": ["title", "lane", "why", "acceptance", "touches"],
  "properties": {
    "title": { "type": "string", "maxLength": 120 },
    "lane": { "enum": ["backend", "frontend", "infra"] },
    "why": { "type": "string", "description": "Which constraint, metric or user need this serves" },
    "acceptance": { "type": "array", "minItems": 1, "maxItems": 10, "items": { "type": "string" } },
    "touches": { "type": "array", "items": { "type": "string" }, "description": "Globs of files expected to change" },
    "migrations": { "type": "boolean", "default": false },
    "adr": { "type": "string", "description": "Title of an ADR to write, if this is a decision" },
    "split": { "type": "array", "items": { "type": "string" }, "description": "Child items if this does not fit one agent session" }
  }
}
