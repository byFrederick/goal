{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Study plan",
  "type": "object",
  "required": ["course", "deliverable", "due", "milestones", "rubric"],
  "properties": {
    "course": { "type": "string" },
    "deliverable": { "type": "string" },
    "due": { "type": "string", "format": "date" },
    "rubric": { "type": "array", "items": { "type": "object", "required": ["criterion", "weight"], "properties": { "criterion": { "type": "string" }, "weight": { "type": "number" } } } },
    "milestones": { "type": "array", "items": { "type": "object", "required": ["title", "due"], "properties": { "title": { "type": "string" }, "due": { "type": "string", "format": "date" } } } },
    "questions": { "type": "array", "items": { "type": "string" }, "description": "Open questions to ask the instructor" }
  }
}
